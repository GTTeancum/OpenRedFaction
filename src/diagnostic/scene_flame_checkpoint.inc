#ifndef SCENE_FLAME_CHECKPOINT_INC
#define SCENE_FLAME_CHECKPOINT_INC
/* RFAP3 kinds8 (canister flight) and9 (stream/throw controller). No raw
 * pointers or absolute frame clocks survive a save. Visual particles are
 * regenerated by ordinary ticks; ignition sounds are not replayed on assign. */
typedef struct scene_flame_checkpoint_stage {
    scene_grenade_projectile flights[SCENE_FLAME_CANISTER_CAPACITY];
    uint32_t values[12],present,seen,live;
} scene_flame_checkpoint_stage;
uint32_t rf_scene_flame_restored[9]; /* live, ignition, reload, gas, cadence, pending, cooldown, held, active */
static void scene_flame_checkpoint_values(uint32_t values[12])
{
    values[0]=scene_flame_input.ignition;values[1]=scene_flame_input.delay;
    values[2]=scene_flame_input.reload_left;
    values[3]=values[2]?scene_flame_input.reload_elapsed:0;
    values[4]=values[2]?scene_flame_input.drained:0;
    values[5]=scene_flame_gas_remainder;
    values[7]=scene_flame_cadence.armed&&scene_flame_cadence.due>combat_frame?
        scene_flame_cadence.due-combat_frame:0;
    values[6]=values[7]!=0;values[8]=scene_flame_active;
    values[9]=scene_flame_canister_held;values[10]=scene_flame_canister_pending;
    values[11]=scene_flame_canister_cooldown;
}
static uint32_t scene_flame_checkpoint_count(void)
{
    uint32_t values[12],i,live=0,pending=0;scene_flame_checkpoint_values(values);
    for(i=0;i<12;i++)pending|=values[i];
    for(i=0;i<SCENE_FLAME_CANISTER_CAPACITY;i++)live+=scene_flame_canisters[i].flight.lifecycle.active!=0;
    return live+(live||pending?1u:0u);
}
static uint32_t scene_flame_checkpoint_capture(unsigned char *p)
{
    uint32_t i,k,rows=0,values[12];
    if(!scene_flame_checkpoint_count())return 0;
    scene_flame_checkpoint_values(values);
    checkpoint_put(p,9);for(k=0;k<12;k++)checkpoint_put(p+16+k*4,values[k]);++rows;
    for(i=0;i<SCENE_FLAME_CANISTER_CAPACITY;i++){
        const scene_grenade_projectile *shot=scene_flame_canisters+i;
        const rf_grenade_flight *f=&shot->flight;unsigned char *r;
        if(!f->lifecycle.active)continue;r=p+112*rows++;
        checkpoint_put(r,8);checkpoint_put(r+4,i);
        for(k=0;k<3;k++){checkpoint_put_float(r+16+k*4,f->position[k]);checkpoint_put_float(r+28+k*4,f->velocity[k]);}
        checkpoint_put_float(r+40,f->radius);checkpoint_put(r+44,f->resting);
        checkpoint_put_float(r+48,f->lifecycle.fuse);checkpoint_put_float(r+52,f->lifecycle.life);
        checkpoint_put(r+60,f->lifecycle.class_flags);checkpoint_put(r+64,f->lifecycle.instance_flags);
        checkpoint_put(r+68,shot->has_contact);
        if(shot->has_contact){checkpoint_put_float(r+72,shot->last_contact.hit.fraction);
            for(k=0;k<3;k++)checkpoint_put_float(r+76+k*4,shot->last_contact.hit.normal[k]);}
    }
    return rows;
}
static int scene_flame_checkpoint_read(scene_flame_checkpoint_stage *stage,const unsigned char *r)
{
    uint32_t kind=checkpoint_u32(r),slot=checkpoint_u32(r+4),k;
    if(!scene_flame_resources||checkpoint_u32(r+8)||checkpoint_u32(r+12))return RF_FORMAT;
    if(kind==9){
        uint32_t *v=stage->values;float drain=campaign_primary[10].drain_seconds;
        if(slot||stage->present||!isfinite(drain)||drain<=0||drain>60)return RF_FORMAT;
        for(k=0;k<12;k++)v[k]=checkpoint_u32(r+16+k*4);
        for(k=64;k<112;k++)if(r[k])return RF_FORMAT;
        if(v[0]>2||v[1]>6||v[2]>3600||v[3]>3600||v[4]>1||v[5]>=(uint32_t)ceilf(drain*60)||
           v[6]>1||v[7]>3600||v[8]>1||v[9]>1||v[10]>108||v[11]>3600||
           (!v[0]&&v[1])||(v[0]==2&&v[1])||(!v[2]&&(v[3]||v[4]))||
           (v[2]&&(v[0]||v[10]))||(v[6]!=(v[7]!=0))||(v[8]&&v[0]!=2)||
           (v[10]&&!v[11]))return RF_FORMAT;
        stage->present=1;return RF_OK;
    }
    if(kind==8){
        scene_grenade_projectile *shot;rf_grenade_flight *f;
        if(slot>=SCENE_FLAME_CANISTER_CAPACITY||(stage->seen&(1u<<slot))||checkpoint_u32(r+56))return RF_FORMAT;
        stage->seen|=1u<<slot;shot=stage->flights+slot;f=&shot->flight;
        for(k=0;k<3;k++){
            f->position[k]=checkpoint_float(r+16+k*4);f->velocity[k]=checkpoint_float(r+28+k*4);
            if(!isfinite(f->position[k])||!isfinite(f->velocity[k])||fabsf(f->position[k])>100000||fabsf(f->velocity[k])>100000)return RF_FORMAT;
        }
        f->radius=checkpoint_float(r+40);f->resting=checkpoint_u32(r+44);
        f->lifecycle.fuse=checkpoint_float(r+48);f->lifecycle.life=checkpoint_float(r+52);
        f->lifecycle.class_flags=checkpoint_u32(r+60);f->lifecycle.instance_flags=checkpoint_u32(r+64);
        f->lifecycle.active=1;shot->has_contact=checkpoint_u32(r+68);
        shot->last_contact.hit.fraction=checkpoint_float(r+72);
        for(k=0;k<3;k++){
            shot->last_contact.hit.normal[k]=checkpoint_float(r+76+k*4);
            if(!isfinite(shot->last_contact.hit.normal[k]))return RF_FORMAT;
        }
        for(k=88;k<112;k++)if(r[k])return RF_FORMAT;
        if(f->radius!=.051f||f->resting>1||!isfinite(f->lifecycle.fuse)||f->lifecycle.fuse< -1||f->lifecycle.fuse>10||
           !isfinite(f->lifecycle.life)||f->lifecycle.life< -1||f->lifecycle.life>10||
           f->lifecycle.class_flags||f->lifecycle.instance_flags!=0x10u||shot->has_contact>1||
           (shot->has_contact&&(!isfinite(shot->last_contact.hit.fraction)||shot->last_contact.hit.fraction<0||shot->last_contact.hit.fraction>1)))return RF_FORMAT;
        ++stage->live;return RF_OK;
    }
    return RF_FORMAT;
}
static int scene_flame_checkpoint_admit(const scene_flame_checkpoint_stage *stage,const rf_campaign_player_state *player)
{
    const uint32_t *v;int32_t ammo;
    if(!stage||!stage->present)return RF_OK;
    if(!player||campaign_flame_id<0||campaign_flame_id>=64||!player->inventory.owned[campaign_flame_id])return RF_FORMAT;
    v=stage->values;
    if((v[0]||v[2]||v[10])&&player->weapon!=(uint32_t)campaign_flame_id)return RF_FORMAT;
    if(v[10]&&player->inventory.loaded[campaign_flame_id]<=0)return RF_FORMAT;
    ammo=campaign_weapon_supply.definitions[campaign_flame_id].ammo_type;
    if(v[2]&&(ammo<0||ammo>=32||player->inventory.reserve[ammo]<=0))return RF_FORMAT;
    return RF_OK;
}
static void scene_flame_checkpoint_assign(const scene_flame_checkpoint_stage *stage)
{
    const uint32_t *v=stage->values;
    scene_flame_input_reset();scene_flame_canister_reset();scene_flame_active=0;
    memset(rf_scene_flame_restored,0,sizeof(rf_scene_flame_restored));
    if(!stage->present)return;
    memcpy(scene_flame_canisters,stage->flights,sizeof(stage->flights));
    scene_flame_input.ignition=v[0];scene_flame_input.delay=v[1];scene_flame_input.reload_left=v[2];
    scene_flame_input.reload_elapsed=v[3];scene_flame_input.drained=v[4];scene_flame_gas_remainder=v[5];
    scene_flame_cadence.armed=v[6];scene_flame_cadence.due=combat_frame+v[7];scene_flame_active=v[8];
    scene_flame_canister_held=v[9];scene_flame_canister_pending=v[10];scene_flame_canister_cooldown=v[11];
    rf_scene_flame_canister[3]=stage->live;
    if(campaign_equipped_slot==10)rf_scene_combat[6]=v[2];
    rf_scene_flame_restored[0]=stage->live;rf_scene_flame_restored[1]=v[0];rf_scene_flame_restored[2]=v[2];
    rf_scene_flame_restored[3]=v[5];rf_scene_flame_restored[4]=v[7];rf_scene_flame_restored[5]=v[10];
    rf_scene_flame_restored[6]=v[11];rf_scene_flame_restored[7]=v[9];rf_scene_flame_restored[8]=v[8];
}
#endif
