#define SCENE_PLAYER_SIZE(name) +sizeof(name)
enum {SCENE_PLAYER_STORE_BYTES=0 SCENE_PLAYER_STATE(SCENE_PLAYER_SIZE)};
#undef SCENE_PLAYER_SIZE
#define SCENE_PLAYER_REGION(name) {&name,sizeof(name)},
static const struct {void *address;uint32_t bytes;} scene_player_regions[]={SCENE_PLAYER_STATE(SCENE_PLAYER_REGION)};
#undef SCENE_PLAYER_REGION
/* Parked state of the human not currently live (one block: two players). */
static uint8_t scene_player_store[SCENE_PLAYER_STORE_BYTES];
uint32_t rf_scene_player_context[4]; /* harness: live player, exchanges, store bytes, self-test */
/* Exchange the live player globals with the parked block. */
static void scene_player_exchange(void)
{
    static uint8_t temporary[4096];uint8_t *store=scene_player_store;uint32_t i,j,n;
    for(i=0;i<sizeof(scene_player_regions)/sizeof(scene_player_regions[0]);i++){
        uint8_t *live=(uint8_t *)scene_player_regions[i].address;
        for(j=0;j<scene_player_regions[i].bytes;j+=n){
            n=scene_player_regions[i].bytes-j;if(n>sizeof(temporary))n=sizeof(temporary);
            memcpy(temporary,live+j,n);memcpy(live+j,store+j,n);memcpy(store+j,temporary,n);
        }
        store+=scene_player_regions[i].bytes;
    }
    rf_scene_player_context[0]^=1u;++rf_scene_player_context[1];rf_scene_player_context[2]=SCENE_PLAYER_STORE_BYTES;
}
/* Make player slot (0 or 1) live. */
__attribute__((unused)) static void scene_player_select(uint32_t slot)
{if((slot&1u)!=rf_scene_player_context[0])scene_player_exchange();}
/* Park a copy of the live player as the other slot (match start). */
__attribute__((unused)) static void scene_player_clone(void)
{
    uint8_t *store=scene_player_store;uint32_t i;
    for(i=0;i<sizeof(scene_player_regions)/sizeof(scene_player_regions[0]);i++){
        memcpy(store,scene_player_regions[i].address,scene_player_regions[i].bytes);store+=scene_player_regions[i].bytes;
    }
}
static void scene_player_test_mark(void){++rf_scene_player_context[3];}
