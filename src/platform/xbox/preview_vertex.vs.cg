struct Input { float3 position : POSITION; float3 color : DIFFUSE; float3 texture : TEXCOORD0; float3 lightmap : TEXCOORD1; };
struct Output { float4 position : POSITION; float4 color : COLOR; float4 texture : TEXCOORD0; float4 lightmap : TEXCOORD1; };
Output main(Input input, uniform float4 viewport : register(c95), uniform float4 opacity : register(c1)) {
    Output output;
    output.position = float4(input.position, 1.0);
    output.color = float4(input.color, opacity.x);
    output.texture = float4(input.texture.xy, 0.0, input.texture.z);
    output.lightmap = float4(input.lightmap.xy, 0.0, input.lightmap.z);
    // Screen mode: 640x480 picture scaled/offset into the framebuffer (c95).
    output.position.xy = output.position.xy * viewport.xy + viewport.zw;
    return output;
}
